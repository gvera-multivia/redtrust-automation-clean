set "REDTRUST_MSI=\\Server-doc\escaneado-mariela\Instalaciones\rt-agent-3.61.2-generic-LocalUsers\rt-agent-x64-3.61.2-93614707-MS-WO.msi"
if exist "!REDTRUST_MSI!" (
