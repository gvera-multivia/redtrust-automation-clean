        echo After downloading, please run this script again.
        pause
        endlocal
        exit /b 1
    )
    goto check_git
)
:after_git_check

REM Step 2: Check Python installation with 3 retries
echo.
echo [2/10] Checking Python installation...
setlocal enabledelayedexpansion
set "max_retries=3"
set "PYTHON_RETRIES=0"
