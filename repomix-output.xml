            AND LOWER(cs.sede) IN ('dehù', 'enotum') 
            AND em.body_html IS NOT NULL
            AND em.date > GETDATE()-9 AND em.date <= GETDATE()-2
			AND es.name in ('Pendiente', 'Agencia Tributaria')
            AND (
                EXISTS (
