                    JSON.stringify(info.requestBody.formData),
                    info.initiator);
                if (!samlResult.result)
                {
                    if(samlResult.policy){
                        console.consoleLogForce(constants.NAV_REQUEST, `WRONG SAMLRESPONSE PROCESS - CANCEL`);
